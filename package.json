{
  "name": "openpresent",
  "version": "0.3.0",
  "private": true,
  "description": "Open-source React framework and browser runtime for AI-authored HTML presentations.",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter @openpresent/showcase dev",
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:cli": "pnpm build && node tests/cli-smoke.mjs",
    "test:pack": "pnpm build && node tests/pack-consumer-smoke.mjs",
    "test:studio": "pnpm --filter @openpresent/core build && pnpm --filter @openpresent/studio build && pnpm --filter @openpresent/mcp build && node tests/studio-browser.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "validate": "pnpm --filter @openpresent/cli... build && node packages/cli/dist/index.js validate examples/showcase/src/deck.tsx",
    "validate:showcase": "pnpm build && node tests/validate-showcase.mjs",
    "check": "pnpm typecheck && pnpm build && pnpm test && pnpm validate",
    "release": "pnpm check && node scripts/release.mjs"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vamgan/openpresent.git"
  },
  "homepage": "https://github.com/vamgan/openpresent#readme",
  "bugs": {
    "url": "https://github.com/vamgan/openpresent/issues"
  },
  "keywords": [
    "presentations",
    "slides",
    "react",
    "ai-agents",
    "acp",
    "mcp",
    "typescript"
  ]
}
