{
  "name": "@openpresent/studio",
  "version": "0.3.0",
  "description": "Loopback-only local AI authoring engine and browser workspace for OpenPresent.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external playwright && vite build --config vite.config.ts && node scripts/copy-starter.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../.. && vitest run packages/studio/src packages/studio/browser/src"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@assistant-ui/react": "^0.15.16",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@openpresent/components": "workspace:*",
    "@openpresent/core": "workspace:*",
    "@openpresent/skills": "workspace:*",
    "@openpresent/validator": "workspace:*",
    "@vitejs/plugin-react": "^5.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "playwright": "^1.55.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vamgan/openpresent.git",
    "directory": "packages/studio"
  },
  "homepage": "https://github.com/vamgan/openpresent#readme",
  "bugs": {
    "url": "https://github.com/vamgan/openpresent/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
